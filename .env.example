# Public URL of the site, used in password reset emails and social metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Postgres connection string (Supabase, Neon, Vercel Postgres, or local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/harbour?schema=public"

# Auth.js secret: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=""

# First admin account, created by `npm run db:seed` if it does not exist
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Optional: Resend API key for sending emails. Without it, emails are printed to the server log.
RESEND_API_KEY=""
EMAIL_FROM="Harbour Rod & Reel Club <no-reply@example.com>"
