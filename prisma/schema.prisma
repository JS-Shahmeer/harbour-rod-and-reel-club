// Content models ported from the Base44 entities.
// Member, payment, leaderboard and store models are added in later steps.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  date        DateTime @db.Date
  time        String?
  location    String?
  category    String   @default("Club Meeting")
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tournament {
  id                 String   @id @default(cuid())
  title              String
  date               DateTime @db.Date
  location           String?
  category           String   @default("Members Only")
  description        String?
  registrationStatus String   @default("Coming Soon")
  resultsSummary     String?
  imageUrl           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  category    String    @default("Club News")
  publishDate DateTime? @db.Date
  excerpt     String?
  body        String?
  imageUrl    String?
  author      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model GalleryAlbum {
  id            String    @id @default(cuid())
  title         String
  category      String    @default("Fishing")
  albumDate     DateTime? @db.Date
  coverImageUrl String?
  description   String?
  imageUrls     String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Milestone {
  id          String   @id @default(cuid())
  year        String?
  title       String
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FishingResource {
  id        String   @id @default(cuid())
  title     String
  topic     String   @default("Techniques")
  summary   String?
  body      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String   @default("General Question")
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}
